# Third-party dependencies.
#   Windows/MSVC : vcpkg manifest (vcpkg.json) provides everything.
#   Linux        : distro packages (see Docs/BUILD.md).
#   MinGW cross  : Tools/ci/setup-mingw-deps.sh builds OpenSSL/libusb into a sysroot.
find_package(Threads REQUIRED)

# Asio (standalone, header only). On Windows it uses IOCP; on Linux epoll.
find_path(ASIO_INCLUDE_DIR asio.hpp REQUIRED)
add_library(pf_asio INTERFACE)
target_include_directories(pf_asio SYSTEM INTERFACE ${ASIO_INCLUDE_DIR})
target_compile_definitions(pf_asio INTERFACE ASIO_STANDALONE ASIO_NO_DEPRECATED)
target_link_libraries(pf_asio INTERFACE Threads::Threads)
if(WIN32)
    target_link_libraries(pf_asio INTERFACE ws2_32 mswsock)
endif()

# nlohmann/json (header only)
find_package(nlohmann_json 3.10 QUIET)
if(NOT nlohmann_json_FOUND)
    find_path(NLOHMANN_INCLUDE_DIR nlohmann/json.hpp REQUIRED)
    add_library(nlohmann_json::nlohmann_json INTERFACE IMPORTED)
    target_include_directories(nlohmann_json::nlohmann_json SYSTEM INTERFACE ${NLOHMANN_INCLUDE_DIR})
endif()

# OpenSSL 3 (TLS 1.3, PBKDF2, Ed25519, certificate generation)
find_package(OpenSSL 3.0 REQUIRED)
if(MINGW)
    target_link_libraries(OpenSSL::Crypto INTERFACE ws2_32 crypt32 bcrypt)
endif()

# libusb-1.0 (server USB backend; UsbDk/WinUSB on Windows, usbfs on Linux)
set(PF_HAVE_LIBUSB OFF)
if(PF_WITH_LIBUSB)
    find_package(PkgConfig QUIET)
    if(PkgConfig_FOUND)
        pkg_check_modules(LIBUSB QUIET IMPORTED_TARGET libusb-1.0)
        if(LIBUSB_FOUND)
            add_library(pf_libusb INTERFACE)
            target_link_libraries(pf_libusb INTERFACE PkgConfig::LIBUSB)
            set(PF_HAVE_LIBUSB ON)
        endif()
    endif()
    if(NOT PF_HAVE_LIBUSB)
        find_path(LIBUSB_INCLUDE_DIR libusb.h PATH_SUFFIXES libusb-1.0)
        find_library(LIBUSB_LIBRARY NAMES usb-1.0 libusb-1.0)
        if(LIBUSB_INCLUDE_DIR AND LIBUSB_LIBRARY)
            add_library(pf_libusb INTERFACE)
            target_include_directories(pf_libusb SYSTEM INTERFACE ${LIBUSB_INCLUDE_DIR})
            target_link_libraries(pf_libusb INTERFACE ${LIBUSB_LIBRARY})
            set(PF_HAVE_LIBUSB ON)
        endif()
    endif()
    if(NOT PF_HAVE_LIBUSB)
        message(WARNING "libusb-1.0 not found: server will only offer the test backend")
    endif()
endif()

# doctest (tests only)
if(PF_BUILD_TESTS)
    find_path(DOCTEST_INCLUDE_DIR doctest/doctest.h REQUIRED)
    add_library(pf_doctest INTERFACE)
    target_include_directories(pf_doctest SYSTEM INTERFACE ${DOCTEST_INCLUDE_DIR})
endif()

# Qt 6 (GUI only)
set(PF_HAVE_QT OFF)
if(PF_BUILD_GUI)
    find_package(Qt6 6.4 QUIET COMPONENTS Widgets Network LinguistTools)
    if(Qt6_FOUND)
        set(PF_HAVE_QT ON)
    else()
        message(STATUS "Qt 6 not found: GUI applications will not be built")
    endif()
endif()
